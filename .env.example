# Atlas: travel intelligence. Copy to .env.local and fill in. Never commit real values.

# Travelpayouts Data API token (free; cached fares, popular directions). SETUP.md §2
TRAVELPAYOUTS_TOKEN=
# Travelpayouts affiliate marker (your partner id, used in booking links). SETUP.md §2
TRAVELPAYOUTS_MARKER=

# Postgres: the shared fare memory, hotel price history, saved trips, search log. SETUP.md §4
# Optional: without it every database function is a quiet no-op and the site runs the same.
# Supabase: use the POOLER in transaction mode, never the direct db.<ref>.supabase.co host
# (IPv6 only, unreachable from Vercel and from most laptops). Shape:
#   postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
# Transaction mode (port 6543) is what Vercel functions and GitHub Actions want; the code
# already sets prepare:false, which that mode requires. Tables are created on first use.
# The same string goes into Vercel (Production) and the GitHub secret DATABASE_URL.
DATABASE_URL=

# LiteAPI hotels: live prices on deal pages, the nightly hotel snapshot (hotel deals). SETUP.md §5
# LITEAPI_ENV=production shows prices to visitors; a sandbox key answers with test rates.
LITEAPI_KEY=
LITEAPI_ENV=sandbox

# Viator Partner API, Basic access. SETUP.md §6
VIATOR_API_KEY=

# Tiqets. SETUP.md §7
TIQETS_API_KEY=
TIQETS_PARTNER_ID=

# DiscoverCars affiliate. SETUP.md §8
DISCOVERCARS_AFFILIATE_ID=
DISCOVERCARS_API_KEY=

# Ticketmaster Discovery (events on the place card). SETUP.md §10
TICKETMASTER_KEY=

# Swiss timetables. SETUP.md §11
OTD_SWISS_KEY=

# Vercel Blob store "atlas-boards": the nightly price boards per airport, stored wild trips
# and plans, the hotel snapshots. Written by the GitHub jobs and the live routes, read by the
# site. Linked to the project on Vercel; locally via `vercel env pull`. SETUP.md §12
BLOB_READ_WRITE_TOKEN=

# The "Ask" agent: one of these. Bedrock takes the bearer token from the AWS console; Azure
# needs a deployment name too. Without either, the Ask box explains itself.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-west-2
ASK_MODEL=us.openai.gpt-6-astra

# Foursquare Places: live restaurant ratings, price tiers and tips for the planner. SETUP.md §13
FOURSQUARE_API_KEY=

# A search key so the planner can read live reviews (either). SETUP.md §14
BRAVE_SEARCH_KEY=
TAVILY_API_KEY=

# Optional tuning. Kiwi's public search is shared by everyone; six at a time is the default.
# KIWI_MAX_CONCURRENT=6
# Hard daily budget of live Kiwi searches per process (lib/kiwi.ts); past it, live searches
# are refused with a plain message and stored results are served. Below Kiwi's ~2,000 limit.
# KIWI_DAILY_BUDGET=1500

# A shared secret that lets `fresh=<token>` on /api/board, /api/wild and /api/plan rebuild a
# stored board, trip or plan. Without it the parameter is ignored, so a public URL cannot be
# reloaded into hundreds of searches. Any long random string; set it on Vercel too.
ATLAS_FRESH_TOKEN=

# The hotel snapshot (scripts/ingest/hotels.ts) writes hotels/latest.json and Postgres only
# on a complete production run; HOTELS_WRITE=1 forces a limited or sandbox run to write for real.
# HOTELS_WRITE=

# The access gate (proxy.ts, lib/access.ts): Atlas is private once these are set.
# ATLAS_ACCESS_CODE is what a visitor types on /access; ATLAS_COOKIE_SECRET signs the 90-day
# cookie (32 random bytes, hex). Without the code the gate is OFF locally, but production
# (VERCEL_ENV=production) answers 503 "not configured" until it is set, unless ATLAS_GATE_OFF=1.
# Under `next dev` the gate stays off unless ATLAS_GATE_DEV=1. Scripts may send the header
# `x-atlas-access: <code>` instead of a cookie. Changing the code signs everyone out. SETUP.md §16
ATLAS_ACCESS_CODE=
ATLAS_COOKIE_SECRET=
# ATLAS_GATE_DEV=1
# ATLAS_GATE_OFF=1   (only to run production deliberately with no gate at all)
# The engine room (/admin): open under `next dev`; on a deployment it asks for this key once per browser
# (at least 6 characters; unset, /admin does not exist there). Keep it secret: it shows every run and price.
ATLAS_ADMIN_KEY=
# ATLAS_RUN_LOG=0   turns off the run log (the engine room's Live tab) on this deployment

# Daily caps on paid or metered calls, global across instances when DATABASE_URL is set
# (lib/usage-caps.ts, table usage_daily). Past a cap the call answers "daily limit reached".
# ATLAS_CAP_CHAT_TURN=400
# ATLAS_CAP_MODEL_CALL=250
# ATLAS_CAP_TAVILY=250
# ATLAS_CAP_FOURSQUARE=250
# ATLAS_CAP_LITEAPI=400
# ATLAS_CAPS_OFF=1   (skip the caps, e.g. for a one-off local script; GitHub Actions skips them already)
# One brain (docs/plans/one-brain.md): 1 makes Search answer from the price map and its live check alone
# (a search may still ask engine: classic). Production: 1.
# ATLAS_ONE_BRAIN=1
# ATLAS_TP_EDGES=0   leaves Travelpayouts out of the price map
