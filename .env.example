# Atlas: travel intelligence. Copy to .env.local and fill in. Never commit real values.

# Travelpayouts Data API token (free; cached fares, popular directions). SETUP.md §2
TRAVELPAYOUTS_TOKEN=
# Travelpayouts affiliate marker (your partner id, used in booking links). SETUP.md §2
TRAVELPAYOUTS_MARKER=

# Neon Postgres connection string (graph, trips, users). SETUP.md §4
DATABASE_URL=

# LiteAPI hotels. SETUP.md §5
LITEAPI_KEY=
LITEAPI_ENV=sandbox

# Viator Partner API, Basic access. SETUP.md §6
VIATOR_API_KEY=

# Tiqets. SETUP.md §7
TIQETS_API_KEY=
TIQETS_PARTNER_ID=

# DiscoverCars affiliate. SETUP.md §8
DISCOVERCARS_AFFILIATE_ID=
DISCOVERCARS_API_KEY=
