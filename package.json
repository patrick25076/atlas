{
  "name": "atlas",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-worker.mjs",
    "ingest": "pnpm ingest:airports && pnpm ingest:routes && pnpm ingest:tp-airports",
    "ingest:airports": "tsx scripts/ingest/airports.ts",
    "ingest:routes": "tsx scripts/ingest/routes.ts",
    "ingest:tp-airports": "tsx scripts/ingest/tp-airports.ts",
    "check:tp": "tsx scripts/check-travelpayouts.ts"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/maplibre": "9.4.0",
    "maplibre-gl": "6.13.0",
    "next": "16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4",
    "typescript": "^5"
  }
}
